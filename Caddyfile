# Caddyfile — Infosecure Solutions
# Open-source web server (Apache 2.0 license) serving static assets
# with full security header control.
#
# Replace infosecuresolutions.co.in with your actual domain.
# Place this file at the project root or in the Caddy config directory.

infosecuresolutions.co.in {
        root * /srv/www
        file_server

        # Reverse proxy for API endpoints (keeps secrets server-side)
        reverse_proxy /api/* api:3001

        # Security headers — all enforced at the HTTP response level
        header {
                # Remove server identification banner
                -Server

                # Clickjacking protection
                X-Frame-Options "DENY"

                # Content Security Policy (enforced via HTTP header — meta CSP
                # cannot set frame-ancestors; this header does)
                Content-Security-Policy "default-src 'self'; script-src 'self' plausible.io; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' api.github.com plausible.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self';"

                # MIME sniffing protection
                X-Content-Type-Options "nosniff"

                # XSS filter (legacy, set to 0 to disable the deprecated filter)
                X-XSS-Protection "0"

                # Referrer policy
                Referrer-Policy "strict-origin-when-cross-origin"

                # Restrict CORS to the site's own origin
                Access-Control-Allow-Origin "https://www.infosecuresolutions.co.in"
                Access-Control-Allow-Methods "GET, OPTIONS"
                Access-Control-Allow-Headers "Content-Type"
                Access-Control-Max-Age "86400"

                # Permissions Policy (formerly Feature Policy)
                Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        }

        # Handle CORS preflight requests
        @cors_preflight method OPTIONS
        handle @cors_preflight {
                header {
                        Access-Control-Allow-Origin "https://www.infosecuresolutions.co.in"
                        Access-Control-Allow-Methods "GET, OPTIONS"
                        Access-Control-Allow-Headers "Content-Type"
                }
                respond "" 204
        }

        # Enable gzip compression for text-based assets
        encode gzip zstd

        # Logging
        log {
                output file /var/log/caddy/access.log {
                        roll_size 100MiB
                        roll_keep 5
                        roll_keep_for 30d
                }
                format json
        }
}
